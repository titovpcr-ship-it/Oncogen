# Скопировать в .env (chmod 600) и заполнить. .env в git не попадает.
#
# eBay Developer Program → Application Keys → Production:
# App ID (Client ID) и Cert ID (Client Secret). Нужен только Browse API.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
#
# Telegram: бот у @BotFather → токен; написать боту «hi», затем открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates → chat.id
TG_BOT_TOKEN=
TG_CHAT_ID=
#
# Discogs → Settings → Developers → Generate new token.
# Без токена работает, но 25 запросов в минуту вместо 60.
DISCOGS_TOKEN=
#
# Необязательно: Best Buy Products API (developer.bestbuy.com). Ключ
# получить не удалось — регистрация закрыта для владельца.
# BESTBUY_API_KEY=
