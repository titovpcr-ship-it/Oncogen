# Скопируйте в .env и заполните (файл .env не попадает в git)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Gemini API (де-шаблонизация примеров C1-C2 в tools/enrich_c1_c2_gemini.py)
GEMINI_API_KEY=

# Dodo Payments (3-уровневая тарифная сетка)
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_MONTH=
DODO_PRODUCT_YEAR=
DODO_PRODUCT_LIFE=
PRICE_MONTH_LABEL=$12
PRICE_YEAR_LABEL=$59
PRICE_LIFE_LABEL=$129
